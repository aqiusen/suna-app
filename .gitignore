# Dependencies
node_modules/
.pnpm-store/

# Frontend output and local tooling
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example

# Go output, coverage, and local development state
bin/
coverage/
*.test
*.out
*.prof
*.coverprofile

# Staged frontend assets are generated for release builds. Keep the tracked
# placeholder so the go:embed pattern remains valid in clean checkouts.
gateway/internal/webassets/dist/*
!gateway/internal/webassets/dist/.gitkeep

# Gateway local state, logs, and development certificates
.gateway/
*.log
*.pem
*.key

# Editors and operating systems
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*.swo
*~

# Package manager and debugger logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Release and desktop packaging output
/dist/
gateway/build/*
!gateway/build/darwin/
gateway/build/darwin/*
!gateway/build/darwin/Info.plist
gateway/frontend/
frontend/src-tauri/target/
frontend/src-tauri/gen/
